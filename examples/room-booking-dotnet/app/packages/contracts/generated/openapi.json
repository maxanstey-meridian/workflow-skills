{
  "openapi": "3.1.0",
  "info": {
    "title": "Room Booking API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Bookings"
    },
    {
      "name": "Rooms"
    },
    {
      "name": "Users"
    }
  ],
  "paths": {
    "/api/bookings": {
      "post": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "create",
        "operationId": "bookings_create",
        "tags": [
          "Bookings"
        ],
        "description": "Book a room for a time slot. The hold lasts until the slot ends, but expires 15 minutes after the start unless the booking is checked in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "403": {
            "description": "Only members can book rooms."
          },
          "409": {
            "description": "The room is already held at overlapping times.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The booking details are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/mine": {
      "get": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "mine",
        "operationId": "bookings_mine",
        "tags": [
          "Bookings"
        ],
        "description": "The acting member\u0027s bookings, newest slot first, with what each allows now.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyBookingsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/cancel": {
      "post": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "cancel",
        "operationId": "bookings_cancel",
        "tags": [
          "Bookings"
        ],
        "description": "Cancel a booking you own.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "403": {
            "description": "The booking belongs to someone else.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such booking.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The booking cannot be cancelled right now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/check-in": {
      "post": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "checkIn",
        "operationId": "bookings_checkIn",
        "tags": [
          "Bookings"
        ],
        "description": "Check in to a booking you own, from its start until 15 minutes after.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "403": {
            "description": "The booking belongs to someone else.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such booking.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The booking cannot be checked in right now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{roomId}/availability": {
      "get": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "availability",
        "operationId": "bookings_availability",
        "tags": [
          "Bookings"
        ],
        "description": "What is already held of a room on a day, in the booking zone.",
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms": {
      "post": {
        "x-rivet-contract": "rooms",
        "x-rivet-endpoint": "create",
        "operationId": "rooms_create",
        "tags": [
          "Rooms"
        ],
        "description": "Add a room that members can book.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRoomRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddRoomResponse"
                }
              }
            }
          },
          "403": {
            "description": "Only staff can add rooms."
          },
          "422": {
            "description": "The room details are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "x-rivet-contract": "rooms",
        "x-rivet-endpoint": "list",
        "operationId": "rooms_list",
        "tags": [
          "Rooms"
        ],
        "description": "Every room, with how many people it holds.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "x-rivet-contract": "users",
        "x-rivet-endpoint": "session",
        "operationId": "users_session",
        "tags": [
          "Users"
        ],
        "description": "The acting user and what they can do.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "The acting user is not signed in."
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "x-rivet-contract": "users",
        "x-rivet-endpoint": "list",
        "operationId": "users_list",
        "tags": [
          "Users"
        ],
        "description": "Every user, for choosing who to act as.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "devUser": []
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "code",
          "message",
          "errors"
        ]
      },
      "BookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "roomName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "checkInAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "checkInClosesAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "availableActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingAction"
            }
          }
        },
        "required": [
          "id",
          "roomId",
          "roomName",
          "start",
          "end",
          "status",
          "checkInAt",
          "checkInClosesAt",
          "availableActions"
        ]
      },
      "CreateBookingRequest": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          }
        },
        "required": [
          "roomId",
          "start",
          "end"
        ]
      },
      "MyBookingsResponse": {
        "type": "object",
        "properties": {
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingDto"
            }
          }
        },
        "required": [
          "bookings"
        ]
      },
      "AvailabilityInterval": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "busy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityInterval"
            }
          }
        },
        "required": [
          "roomId",
          "date",
          "busy"
        ]
      },
      "AddRoomResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id",
          "name",
          "capacity"
        ]
      },
      "AddRoomRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "name",
          "capacity"
        ]
      },
      "RoomDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id",
          "name",
          "capacity"
        ]
      },
      "RoomsResponse": {
        "type": "object",
        "properties": {
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomDto"
            }
          }
        },
        "required": [
          "rooms"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "CapabilitiesDto": {
        "type": "object",
        "properties": {
          "canManageRooms": {
            "type": "boolean"
          },
          "canBookRooms": {
            "type": "boolean"
          }
        },
        "required": [
          "canManageRooms",
          "canBookRooms"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "capabilities": {
            "$ref": "#/components/schemas/CapabilitiesDto"
          }
        },
        "required": [
          "user",
          "capabilities"
        ]
      },
      "UsersResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserDto"
            }
          }
        },
        "required": [
          "users"
        ]
      },
      "BookingStatus": {
        "type": "string",
        "enum": [
          "booked",
          "checkedIn",
          "cancelled",
          "released"
        ],
        "x-rivet-enum-naming-policy": "camelCase"
      },
      "BookingAction": {
        "type": "string",
        "enum": [
          "cancel",
          "checkIn"
        ],
        "x-rivet-enum-naming-policy": "camelCase"
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "staff",
          "member"
        ],
        "x-rivet-enum-naming-policy": "camelCase"
      }
    },
    "securitySchemes": {
      "devUser": {
        "type": "apiKey",
        "name": "X-User-Email",
        "in": "header"
      }
    }
  }
}