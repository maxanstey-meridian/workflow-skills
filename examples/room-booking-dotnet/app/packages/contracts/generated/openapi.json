{
  "openapi": "3.1.0",
  "info": {
    "title": "Cowork Rooms API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5213"
    }
  ],
  "tags": [
    {
      "name": "Bookings"
    },
    {
      "name": "Rooms"
    }
  ],
  "paths": {
    "/api/bookings": {
      "post": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "book",
        "operationId": "bookings_book",
        "tags": [
          "Bookings"
        ],
        "description": "Book a room for a time slot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookRoomRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Room not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The room is already held at overlapping times",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "listMine",
        "operationId": "bookings_listMine",
        "tags": [
          "Bookings"
        ],
        "description": "The caller\u0027s bookings, soonest first.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingResponse"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/cancel": {
      "post": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "cancel",
        "operationId": "bookings_cancel",
        "tags": [
          "Bookings"
        ],
        "description": "Cancel one of the caller\u0027s bookings before it starts.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The booking cannot be cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/check-in": {
      "post": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "checkIn",
        "operationId": "bookings_checkIn",
        "tags": [
          "Bookings"
        ],
        "description": "Check in to one of the caller\u0027s bookings.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The booking cannot be checked in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{roomId}/day": {
      "get": {
        "x-rivet-contract": "bookings",
        "x-rivet-endpoint": "roomDay",
        "operationId": "bookings_roomDay",
        "tags": [
          "Bookings"
        ],
        "description": "The holds one room already has on one day, so a free slot can be picked.",
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomDayResponse"
                }
              }
            }
          },
          "404": {
            "description": "Room not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms": {
      "get": {
        "x-rivet-contract": "rooms",
        "x-rivet-endpoint": "list",
        "operationId": "rooms_list",
        "tags": [
          "Rooms"
        ],
        "description": "Every room in the space, by name.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoomResponse"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "x-rivet-contract": "rooms",
        "x-rivet-endpoint": "create",
        "operationId": "rooms_create",
        "tags": [
          "Rooms"
        ],
        "description": "Add a room to the space.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "dev": []
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "code",
          "message",
          "errors"
        ]
      },
      "BookingActionResponse": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "action",
          "enabled",
          "reason"
        ]
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "roomName": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "status": {
            "type": "string"
          },
          "availableActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingActionResponse"
            }
          }
        },
        "required": [
          "id",
          "roomId",
          "roomName",
          "startsAt",
          "endsAt",
          "status",
          "availableActions"
        ]
      },
      "BookRoomRequest": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          }
        },
        "required": [
          "roomId",
          "startsAt",
          "endsAt"
        ]
      },
      "RoomHoldResponse": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "status"
        ]
      },
      "RoomDayResponse": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "holds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomHoldResponse"
            }
          }
        },
        "required": [
          "roomId",
          "date",
          "holds"
        ]
      },
      "RoomResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id",
          "name",
          "capacity"
        ]
      },
      "CreateRoomRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "name",
          "capacity"
        ]
      }
    },
    "securitySchemes": {
      "dev": {
        "type": "apiKey",
        "name": "X-Dev-User",
        "in": "header"
      }
    }
  }
}