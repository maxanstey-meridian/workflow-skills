{
  "categories": {
    "correctness": "warn"
  },
  "ignorePatterns": [".nuxt", ".output", "dist", "node_modules"],
  "rules": {
    "no-unused-vars": "warn",
    "curly": ["error", "all"],
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }]
  }
}
