{
  "name": "room-booking-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "gen:api": "cp ../api/generated/openapi.json app/api/generated/openapi.json && openapi-typescript app/api/generated/openapi.json -o app/api/generated/schema.d.ts",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint app --config .oxlintrc.json; eslint .",
    "format:check": "oxfmt check app --config .oxfmtrc.json",
    "test": "TZ=UTC vitest run"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "nuxt": "^4.6.4",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.5.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.30.0",
    "happy-dom": "^18.0.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver",
      "@parcel/watcher",
      "workerd",
      "simple-git-hooks",
      "magic-regexp",
      "oxc-resolver"
    ]
  }
}
