{
  "openapi": "3.1.0",
  "info": {
    "title": "Room Booking API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "tags": [
    {
      "name": "Booking"
    },
    {
      "name": "Identity"
    }
  ],
  "paths": {
    "/api/rooms": {
      "get": {
        "x-rivet-contract": "booking",
        "x-rivet-endpoint": "listRooms",
        "operationId": "booking_listRooms",
        "tags": [
          "Booking"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "x-rivet-contract": "booking",
        "x-rivet-endpoint": "addRoom",
        "operationId": "booking_addRoom",
        "tags": [
          "Booking"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRoomRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomView"
                }
              }
            }
          },
          "403": {
            "description": "Only staff can add rooms",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A room with this name already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/availability": {
      "get": {
        "x-rivet-contract": "booking",
        "x-rivet-endpoint": "listAvailability",
        "operationId": "booking_listAvailability",
        "tags": [
          "Booking"
        ],
        "parameters": [
          {
            "name": "startUtc",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "x-rivet-csharp-type": "DateTimeOffset"
            }
          },
          {
            "name": "endUtc",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "x-rivet-csharp-type": "DateTimeOffset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "x-rivet-contract": "booking",
        "x-rivet-endpoint": "listBookings",
        "operationId": "booking_listBookings",
        "tags": [
          "Booking"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Only members list their bookings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "x-rivet-contract": "booking",
        "x-rivet-endpoint": "createBooking",
        "operationId": "booking_createBooking",
        "tags": [
          "Booking"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookRoomRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingView"
                }
              }
            }
          },
          "403": {
            "description": "Only members can book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The room does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The booking was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/cancel": {
      "post": {
        "x-rivet-contract": "booking",
        "x-rivet-endpoint": "cancelBooking",
        "operationId": "booking_cancelBooking",
        "tags": [
          "Booking"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingView"
                }
              }
            }
          },
          "403": {
            "description": "Not the member\u0027s booking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The booking does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The booking was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/check-in": {
      "post": {
        "x-rivet-contract": "booking",
        "x-rivet-endpoint": "checkInBooking",
        "operationId": "booking_checkInBooking",
        "tags": [
          "Booking"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingView"
                }
              }
            }
          },
          "403": {
            "description": "Not the member\u0027s booking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The booking does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The booking was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "x-rivet-contract": "identity",
        "x-rivet-endpoint": "listUsers",
        "operationId": "identity_listUsers",
        "tags": [
          "Identity"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "schemas": {
      "RoomView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id",
          "name",
          "capacity"
        ]
      },
      "RoomsResponse": {
        "type": "object",
        "properties": {
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomView"
            }
          }
        },
        "required": [
          "rooms"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "code",
          "message",
          "errors"
        ]
      },
      "AddRoomRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "name",
          "capacity"
        ]
      },
      "RoomAvailabilityView": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "isAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "roomId",
          "name",
          "capacity",
          "isAvailable"
        ]
      },
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomAvailabilityView"
            }
          }
        },
        "required": [
          "rooms"
        ]
      },
      "BookingView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "roomName": {
            "type": "string"
          },
          "startUtc": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "endUtc": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatusWire"
          },
          "availableActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingActionWire"
            }
          }
        },
        "required": [
          "id",
          "roomId",
          "roomName",
          "startUtc",
          "endUtc",
          "status",
          "availableActions"
        ]
      },
      "BookingsResponse": {
        "type": "object",
        "properties": {
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingView"
            }
          }
        },
        "required": [
          "bookings"
        ]
      },
      "BookRoomRequest": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "startUtc": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          },
          "endUtc": {
            "type": "string",
            "format": "date-time",
            "x-rivet-csharp-type": "DateTimeOffset"
          }
        },
        "required": [
          "roomId",
          "startUtc",
          "endUtc"
        ]
      },
      "UserView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRoleWire"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "UsersResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserView"
            }
          }
        },
        "required": [
          "users"
        ]
      },
      "BookingStatusWire": {
        "type": "string",
        "enum": [
          "booked",
          "checked-in",
          "cancelled",
          "released"
        ],
        "x-rivet-enum-naming-policy": "kebabCase"
      },
      "BookingActionWire": {
        "type": "string",
        "enum": [
          "check-in",
          "cancel"
        ],
        "x-rivet-enum-naming-policy": "kebabCase"
      },
      "UserRoleWire": {
        "type": "string",
        "enum": [
          "staff",
          "member"
        ],
        "x-rivet-enum-naming-policy": "kebabCase"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "Development auth: the bearer token is a seeded user id.",
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}