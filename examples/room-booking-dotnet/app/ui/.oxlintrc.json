{
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "curly": ["error", "all"],
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }]
  },
  "ignorePatterns": [".nuxt/**", ".output/**", "packages/contracts/generated/**", "node_modules/**"]
}
