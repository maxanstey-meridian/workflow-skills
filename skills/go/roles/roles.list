# The roles of this routine, built by lib/build-roles/src/cli.ts into ../references/. Two kinds of line:
#   role <name> <reads> <part>[,<part>...]
#     builds references/<name>.md: a Rules block, then the parts (files in this folder, without .md), in order.
#     <reads> names the rule files the block tells the role to read, always and in full: comma-separated
#     names of skills/meridian/references/rules-<name>.list.
#   rule <file> <rule path>
#     copies one meridian rule to references/<file>, for an orchestrator that needs that rule alone.

role builder  core,invariants,tests,backend,backend-tooling,frontend  builder/head,builder/stop-on-an-open-or-contradicted-spec,builder/edit-only-owned-files-and-honour-spec-decisions,builder/never-narrow-oracle-claims-to-match-a-weaker-test,builder/test-every-added-or-restructured-outcome,builder/run-proof-and-repo-checks-without-the-full-gate,builder/leave-work-uncommitted-and-report-facts-only
role critic   tests  critic/head,critic/judge-from-the-tree-never-the-builders-report,critic/run-proof-and-read-only-checks-yourself,critic/list-every-diff-finding-with-spec-quote-and-location,critic/verify-a-failing-test-for-every-added-or-restructured-outcome,critic/grade-oracle-rows-against-locked-expect,critic/touch-only-the-report-and-never-judge-style-or-recommend
role auditor  core,invariants,tests,backend,backend-tooling,frontend  auditor/head,auditor/verify-every-claim-against-the-tree-or-your-own-run,auditor/run-done-means-commands-skipping-the-full-gate-and-mutation,auditor/settle-every-piece-and-every-decision,auditor/never-park-a-gap-this-work-caused-or-left,auditor/touch-only-the-report-and-end-with-built-pieces
