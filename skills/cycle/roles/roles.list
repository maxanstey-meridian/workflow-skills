# The roles of this routine, built by scripts/build-roles.sh into ../references/. Two kinds of line:
#   role <name> <reads> <part>[,<part>...]
#     builds references/<name>.md: a Rules block, then the parts (files in this folder, without .md), in order.
#     <reads> names the rule files the block tells the role to read, always and in full: comma-separated
#     names of skills/meridian/references/rules-<name>.list.
#   rule <file> <rule path>
#     copies one meridian rule to references/<file>, for an orchestrator that needs that rule alone.

role reviewer                    core,invariants,tests,backend,backend-tooling,frontend  reviewer/head,review-format/head,shared/read-what-you-state-before-claiming,shared/classify-each-finding-as-fix-park-ask-or-nit,shared/touch-only-the-report-and-run-read-only-checks,reviewer/hunt-bugs-tests-bloat-and-switched-paths,reviewer/check-every-owned-piece-against-the-spec,reviewer/never-fix-forward-machinery-added-by-a-fixer
role doctrine-reviewer-backend   core,invariants,tests,backend,backend-tooling           doctrine-reviewer/head,review-format/head,shared/read-what-you-state-before-claiming,shared/classify-each-finding-as-fix-park-ask-or-nit,shared/touch-only-the-report-and-run-read-only-checks,doctrine-reviewer/check-applicable-files-rule-by-rule
role doctrine-reviewer-frontend  core,invariants,tests,frontend                          doctrine-reviewer/head,review-format/head,shared/read-what-you-state-before-claiming,shared/classify-each-finding-as-fix-park-ask-or-nit,shared/touch-only-the-report-and-run-read-only-checks,doctrine-reviewer/check-applicable-files-rule-by-rule
role fixer                       core,invariants,tests,backend,backend-tooling,frontend  fixer/head,fixer/confirm-the-harm-and-settle-ownership-before-editing,fixer/fix-the-root-cause-and-handle-critic-repairs,fixer/edit-only-slice-files-and-never-weaken-checks,fixer/run-targeted-checks-and-generation-without-the-full-gate,fixer/leave-work-uncommitted-and-report-facts-only
role critic                      core,invariants,tests,backend,backend-tooling,frontend  critic/head,critic/judge-from-the-tree-never-the-fixers-claims,critic/run-read-only-checks-and-finding-commands-yourself,critic/grade-every-finding-and-flag-extra-or-spec-breaks,critic/touch-only-the-report-and-never-judge-style-or-recommend
role auditor                     core,invariants,tests,backend,backend-tooling,frontend  auditor/head,auditor/verify-every-claim-against-the-tree-or-your-own-run,auditor/settle-every-piece-and-decision-without-softening,auditor/settle-every-finding-against-the-last-critic-and-code,auditor/audit-commits-gate-log-and-mutation-once,auditor/touch-only-the-report-and-write-plain-english
rule commits.md         tools/write-commit-subjects-as-type-scope-subject.md,tools/never-copy-a-commit-subjects-style-from-the-log.md,tools/pick-the-commit-type-from-the-fixed-list.md,tools/scope-a-commit-to-the-folder-it-changes.md,tools/say-what-changed-and-why-in-the-commit-body.md,tools/mark-a-breaking-change-in-the-commit-footer.md,tools/make-one-commit-per-reviewed-unit.md,tools/derive-the-version-from-the-commits.md
